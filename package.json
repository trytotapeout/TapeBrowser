{
  "name": "tapebrowser",
  "productName": "TapeBrowser",
  "version": "0.9.0",
  "description": "TapeKit DeWEB 桌面浏览器：打开 tape:// 电路网站，桥接浏览器钱包扩展",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trytotapeout/TapeBrowser.git"
  },
  "homepage": "https://github.com/trytotapeout/TapeBrowser",
  "author": {
    "name": "boostbob",
    "url": "https://x.com/boostbob"
  },
  "type": "module",
  "main": "src/main/main.js",
  "desktopName": "tapebrowser.desktop",
  "license": "GPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prestart": "node scripts/dev-branding.mjs",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "live": "node test/live.mjs",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux --x64",
    "dist:all": "npm run dist:mac && npm run dist:win && npm run dist:linux"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "build": {
    "appId": "org.tapekit.tapebrowser",
    "productName": "TapeBrowser",
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "protocols": [
      {
        "name": "TapeKit DeWEB",
        "schemes": [
          "tape"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "directories": {
      "buildResources": "build"
    }
  }
}
